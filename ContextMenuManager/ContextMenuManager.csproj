<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Properties\AppIcon.ico</ApplicationIcon>
    <StartupObject>ContextMenuManager.Program</StartupObject>
    <ApplicationManifest>Properties\App.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<UseVSHostingProcess>true</UseVSHostingProcess>
		<Prefer32Bit>false</Prefer32Bit>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;RELEASE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<Prefer32Bit>false</Prefer32Bit>
		<NoWarn>$(NoWarn);FLSG0007</NoWarn>
	</PropertyGroup>
	
  <ItemGroup>
		<PackageReference Include="FluentIcons.Wpf" Version="2.1.345" />
		<PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.11.0" />
		<PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\ContextMenuManager.CopyPath\ContextMenuManager.CopyPath.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
    <Content Include="Properties\AppIcon.ico" />
    <Resource Include="Properties\Resources\**\*.*" />
    <Resource Include="..\languages\zh-CN.ini" Link="Properties\Resources\Texts\AppLanguageDic.ini" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
  </ItemGroup>

  <Target Name="ResolveCopyPathHelper">
    <MSBuild Projects="..\ContextMenuManager.CopyPath\ContextMenuManager.CopyPath.csproj" Targets="GetCopyPathFiles" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" RemoveProperties="PublishProfile;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="CopyPathHelperFiles" />
    </MSBuild>
  </Target>

  <Target Name="CopyPathHelperAfterBuild" AfterTargets="Build" DependsOnTargets="ResolveCopyPathHelper">
    <Copy SourceFiles="@(CopyPathHelperFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCopyPathHelper" AfterTargets="ComputeFilesToPublish" DependsOnTargets="ResolveCopyPathHelper">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(CopyPathHelperFiles)" CopyToPublishDirectory="Always" RelativePath="%(CopyPathHelperFiles.Filename)%(CopyPathHelperFiles.Extension)" />
    </ItemGroup>
  </Target>

	<ItemGroup>
		<PortableLanguages Include="..\languages\zh-CN.ini;..\languages\zh-TW.ini" />
		<PortableDictionaries Include="Properties\Resources\Texts\*.*" />
	</ItemGroup>

	<Target Name="CopyPortableData" AfterTargets="Publish">
		<Copy SourceFiles="@(PortableLanguages)" DestinationFolder="$(PublishDir)Data\Languages" />
		<Copy SourceFiles="@(PortableDictionaries)" DestinationFolder="$(PublishDir)Data\Dictionaries\Web" />
	</Target>

	<Target Name="CopyFilesAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Copy SourceFiles="@(PortableLanguages)" DestinationFolder="$(TargetDir)Data\Languages" OverwriteReadOnlyFiles="true" />
		<Copy SourceFiles="@(PortableDictionaries)" DestinationFolder="$(TargetDir)Data\Dictionaries\Web" OverwriteReadOnlyFiles="true" />
	</Target>
	
</Project>
