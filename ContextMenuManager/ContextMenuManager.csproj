<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Properties\AppIcon.ico</ApplicationIcon>
    <StartupObject>ContextMenuManager.Program</StartupObject>
    <ApplicationManifest>Properties\App.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<UseVSHostingProcess>true</UseVSHostingProcess>
		<Prefer32Bit>false</Prefer32Bit>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;RELEASE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<Prefer32Bit>false</Prefer32Bit>
		<NoWarn>$(NoWarn);FLSG0007</NoWarn>
	</PropertyGroup>
	
  <ItemGroup>
		<PackageReference Include="FluentIcons.Wpf" Version="2.1.343" />
		<PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
		<PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\ContextMenuManager.CopyPath\ContextMenuManager.CopyPath.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <Content Include="Properties\AppIcon.ico" />
    <Resource Include="Properties\Resources\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
  </ItemGroup>

  <Target Name="CopyPathHelperAfterBuild" AfterTargets="Build">
    <MSBuild Projects="..\ContextMenuManager.CopyPath\ContextMenuManager.CopyPath.csproj" Targets="GetCopyPathFiles" Properties="Configuration=$(Configuration)" RemoveProperties="PublishProfile;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="CopyPathHelperFiles" />
    </MSBuild>
    <Copy SourceFiles="@(CopyPathHelperFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCopyPathHelper" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ContextMenuManager.CopyPath\ContextMenuManager.CopyPath.csproj&quot; --configuration $(Configuration) -p:RuntimeIdentifier=$(RuntimeIdentifier) -p:SelfContained=$(SelfContained) -p:PublishSingleFile=false --output &quot;$([System.IO.Path]::GetFullPath('$(PublishDir)'))&quot;" />
  </Target>

	<Target Name="CopyPortableData" AfterTargets="Publish">
		<ItemGroup>
			<PortableLanguages Include="$(ProjectDir)..\languages\zh-CN.ini;$(ProjectDir)..\languages\zh-TW.ini" />
			<PortableDictionaries Include="$(ProjectDir)Properties\Resources\Texts\*.*" Exclude="$(ProjectDir)Properties\Resources\Texts\AppLanguageDic.ini" />
		</ItemGroup>
		<Copy SourceFiles="@(PortableLanguages)" DestinationFolder="$(PublishDir)Data\Languages" />
		<Copy SourceFiles="$(ProjectDir)Properties\Resources\Texts\AppLanguageDic.ini" DestinationFiles="$(PublishDir)Data\Languages\zh-CN.ini" />
		<Copy SourceFiles="@(PortableDictionaries)" DestinationFolder="$(PublishDir)Data\Dictionaries\Web" />
	</Target>

	<Target Name="CopyFilesAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<MakeDir Directories="$(TargetDir)Data\Languages" />
		<MakeDir Directories="$(TargetDir)Data\Dictionaries\Web" />

		<Copy SourceFiles="$(ProjectDir)Properties\Resources\Texts\AppLanguageDic.ini" DestinationFiles="$(TargetDir)Data\Languages\zh-CN.ini" OverwriteReadOnlyFiles="true" />

		<ItemGroup>
			<LanguageFiles Include="$(ProjectDir)..\languages\zh-CN.ini;$(ProjectDir)..\languages\zh-TW.ini" />
		</ItemGroup>
		<Copy SourceFiles="@(LanguageFiles)" DestinationFolder="$(TargetDir)Data\Languages" OverwriteReadOnlyFiles="true" />

		<ItemGroup>
			<WebDictFiles Include="$(ProjectDir)Properties\Resources\Texts\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(WebDictFiles)" DestinationFolder="$(TargetDir)Data\Dictionaries\Web" OverwriteReadOnlyFiles="true" />

		<Delete Files="$(TargetDir)Data\Dictionaries\Web\AppLanguageDic.ini" />
	</Target>
	
</Project>